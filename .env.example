MERCHANT_ID=your_merchant_id
MERCHANT_KEY=your_merchant_key
MERCHANT_SALT=your_merchant_salt
# Yalnızca localhost — servis nginx/Next.js arkasında; dışarıya yalnızca callback açılır.
HOST=127.0.0.1
PORT=3002
TEST_MODE=1
DATABASE_URL=postgres://actix_user:password@localhost:5432/actix_prod_db
# Development: http://localhost:3002
# Production:  https://api.nlink.tr/paytr  (nginx /paytr/ → localhost:3002)
BASE_URL=http://localhost:3002
# Next.js → servis çağrılarında X-Internal-Token (en az 32 karakter; `openssl rand -hex 32`).
# qurlfrontend .env'inde PAYTR_SERVICE_TOKEN ile AYNI değer olmalı.
INTERNAL_API_TOKEN=change_me_to_a_random_64_char_hex_value____________
RUST_LOG=payment_service=info,tower_http=info,sqlx=warn
# Subscription scheduler aralığı (saniye). Varsayılan: 3600 (1 saat)
SCHEDULER_INTERVAL_SECS=3600
# Yenileme en fazla bu kadar kez (günde bir) denenir. Varsayılan: 3
MAX_FAILED_ATTEMPTS=3
# Ödeme alınamayan aktif abonelik bitişten bu kadar gün sonra expire edilir. Varsayılan: 4
GRACE_DAYS=4
# İnceleme gerektiren ödemeler (tutar uyuşmazlığı, geçersiz aboneliğe tahsilat) bu adrese bildirilir
ALERT_EMAIL=admin@nlink.tr
# Müşterinin telefonu yoksa PayTR'a gönderilen şirket iletişim numarası (PayTR user_phone zorunlu)
PAYTR_FALLBACK_PHONE=5305861333
# Yalnızca testler için: PayTR yerine mock sunucu (varsayılan https://www.paytr.com)
# PAYTR_BASE_URL=http://127.0.0.1:38080
# Email bildirimleri (opsiyonel — tüm değerler girilirse aktif olur)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@nlink.tr
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@nlink.tr
EMAIL_FROM_NAME=nlink.tr
SITE_URL=https://nlink.tr

# e-Arşiv / e-Fatura (Turkcell e-Şirket). Kapalıyken faturalar `pending` kalır.
# DİKKAT: canlı ödemeler varken TEST adresini açmayın — Turkcell gerçek müşterilere test faturası e-postalar.
EINVOICE_ENABLED=0
TURKCELL_EFATURA_BASE_URL=https://efaturaservice.turkcellesirket.com
TURKCELL_EFATURA_API_KEY=
# Bu günden (TR) önce açılan kayıtlar otomatik kesilmez (e-belge geçişi öncesi ödemeler).
EINVOICE_START_DATE=
# Birden çok seri varsa fatura no ön eki (ör. NLK)
EINVOICE_PREFIX=
# e-Arşiv internet satışı taşıyıcısı (dijital hizmet; mali müşavirle teyit edilecek)
EINVOICE_SHIPMENT_TCKNVKN=1111111111
EINVOICE_SHIPMENT_NAME=Elektronik teslimat
