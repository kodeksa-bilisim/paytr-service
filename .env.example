MERCHANT_ID=your_merchant_id
MERCHANT_KEY=your_merchant_key
MERCHANT_SALT=your_merchant_salt
HOST=0.0.0.0
PORT=3001
TEST_MODE=1
DATABASE_URL=postgres://actix_user:password@localhost:5432/actix_prod_db
# Development: http://localhost:3001
# Production:  https://api.nlink.tr/paytr  (nginx /paytr/ → localhost:3001)
BASE_URL=http://localhost:3001
# Subscription scheduler aralığı (saniye). Varsayılan: 3600 (1 saat)
SCHEDULER_INTERVAL_SECS=3600
# Bu sayıda başarısız denemeden sonra abonelik yenilenmez. Varsayılan: 3
MAX_FAILED_ATTEMPTS=3
# Email bildirimleri (opsiyonel — tüm değerler girilirse aktif olur)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@nlink.tr
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@nlink.tr
EMAIL_FROM_NAME=nlink.tr
SITE_URL=https://nlink.tr
